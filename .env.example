# Template for the demo stack's secret env file (spec 007, T023).
#
# Copy this file to the git-ignored secret env file in the repo root before `make up`.
# Every value below is a fake placeholder. Docker Compose reads the copy itself, and these
# are exactly the variables docker-compose.yml interpolates, nothing more.
#
# - Replace ANTHROPIC_API_KEY with a real key to run a screening; the placeholder only lets
#   the web app boot.
# - Keep TRIALBRIDGE_API_KEY equal to a key in keys.json (the CRC key in keys.example.json).

POSTGRES_USER=trialbridge
POSTGRES_PASSWORD=tb_demo_fake_postgres_password

FHIR_CLIENT_ID=trialbridge-demo
FHIR_CLIENT_SECRET=tb_demo_fake_fhir_client_secret

TRIALBRIDGE_API_KEY=tb_demo_fake_crc_0000000000000000
TRIALBRIDGE_SESSION_SECRET=tb_demo_fake_session_secret_0000

ANTHROPIC_API_KEY=tb_demo_fake_anthropic_key
ANTHROPIC_MODEL=claude-opus-5

# Only the loopback demo stack turns the session cookie's Secure flag off, because it serves
# plain http on 127.0.0.1. docker-compose.yml defaults this to true (AD-35); any real
# deployment must leave it true.
SESSION_COOKIE_SECURE=false
